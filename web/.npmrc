# openapi-typescript henuz TypeScript 6'yi peer olarak tanimiyor (peer: ^5.x), ama create-vite
# react-ts sablonu TypeScript ~6.0.2 sabitliyor. Surum degistirmek yerine npm'in peer dependency
# kontrolunu gevsetiyoruz; "npm ci" da ayni sekilde davranmali diye bu dosya commit ediliyor.
legacy-peer-deps=true
